# Copy this file to .env and fill in your real values. Never commit .env to git.

# MongoDB Atlas connection string (get free from mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tsstore

# Secret key used to sign admin login tokens - make this a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# First admin account - created automatically the first time the server starts
ADMIN_EMAIL=admin@tsstore.com
ADMIN_PASSWORD=change_this_password

# Stripe keys (for online card payments) - get free test keys from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# URL where your frontend is hosted (used for Stripe redirect + CORS)
FRONTEND_URL=http://localhost:5500

# Port the backend server runs on
PORT=5000
